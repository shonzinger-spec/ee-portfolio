# wokwi-cli 0.29.1 (0aa185144b92), Tue Nov  3 12:57:24 EST 2026
# ADC probe on a simulated ESP32 (sim/wokwi/probe: adcprobe.ino + vstep chip on GPIO34/35/33).
# cmd (in sim/wokwi/probe, after arduino-cli compile -b esp32:esp32:esp32 --output-dir build adcprobe and building vstep.chip.wasm): wokwi-cli . --timeout 800   (probe v1, 3.3 V held)
# columns: raw = adc_oneshot_read code, cali_mv34 = adc_cali line fitting (simulated eFuse: efuse=0 is ADC_CALI_LINE_FITTING_EFUSE_VAL_EFUSE_VREF), *_us = CPU cycle counter / 240
PROBE efuse_err=0 efuse=0 cali_err=0
PROBE t_us=524179 raw34=2703 raw35=2703 raw33=2703 cali_mv34=2417 read1_us=56.97 read3_us=141.57 cali_us=6.25
PROBE
# probe v2: adcprobe.ino as in sim/wokwi/probe now (oneshot vs direct SENS-register reads), vstep steps after 600 ms; cmd: wokwi-cli . --timeout 680
[chip-vstep] VSTEP t_us=5000 v=0.250
[chip-vstep] VSTEP t_us=610000 v=0.500
[chip-vstep] VSTEP t_us=615000 v=1.000
[chip-vstep] VSTEP t_us=620000 v=2.000
[chip-vstep] VSTEP t_us=625000 v=2.024
[chip-vstep] VSTEP t_us=630000 v=3.000
[chip-vstep] VSTEP t_us=635000 v=3.300
[chip-vstep] VSTEP t_us=640000 v=4.000
[chip-vstep] VSTEP t_us=645000 v=4.900
[chip-vstep] VSTEP t_us=650000 v=6.000
PROBE2 start
